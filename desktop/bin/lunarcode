#!/bin/sh
# Lunarcode desktop CLI (Linux/macOS): runs server/cli.mjs on the app's own Node runtime.
# Put a symlink to this file on your PATH. LUNARCODE_EXE overrides the executable.
DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
for exe in "$LUNARCODE_EXE" "$DIR/../../../Lunarcode" "$DIR/../../../lunarcode" "$DIR/../../../MacOS/Lunarcode"; do
  if [ -n "$exe" ] && [ -x "$exe" ]; then
    ELECTRON_RUN_AS_NODE=1 exec "$exe" "$DIR/../server/cli.mjs" "$@"
  fi
done
echo "lunarcode: could not find the Lunarcode executable (set LUNARCODE_EXE)." >&2
exit 1
